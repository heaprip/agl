# Ньютон — исполняемый срез docs/cases/newton.md:
# проверка на Луне, где допуск вопроса задан осью плоскости.

axis discourse
value discourse physics
value discourse narrative

axis precision
value precision coarse
value precision fine

plane phys = discourse:physics
plane narr = discourse:narrative

# Рассказ — со статусом анекдота, в своей плоскости.
fact a1: fall(object: apple1, toward: earth) @ narr [anecdote]

fact g1: g(value: 9.81[m/s^2]) @ phys [measurement]
fact m1: observed(quantity: a_moon, value: 0.00272[m/s^2]) @ phys [measurement]
fact tc: tolerance(rel: 0.02) @ precision:coarse
fact tf: tolerance(rel: 0.000001) @ precision:fine

# Луна на расстоянии 60.3 радиуса Земли: закон обратных квадратов.
rule p1 strict @ phys: predicted(quantity: a_moon, value: ?v) <- g(value: ?g), ?v = ?g / 60.3^2

rule ok strict @ phys: agrees(quantity: ?q) <-
    predicted(quantity: ?q, value: ?p), observed(quantity: ?q, value: ?o), tolerance(rel: ?t),
    ((?p - ?o) / ?o)^2 <= ?t^2
rule no strict @ phys: ¬agrees(quantity: ?q) <-
    predicted(quantity: ?q, value: ?p), observed(quantity: ?q, value: ?o), tolerance(rel: ?t),
    ((?p - ?o) / ?o)^2 > ?t^2

query agrees(quantity: a_moon) @ phys + precision:coarse expect yes
query agrees(quantity: a_moon) @ phys + precision:fine   expect no
query agrees(quantity: a_moon) @ phys                    expect unknown
query fall(object: apple1, toward: earth) @ phys         expect unknown
query fall(object: apple1, toward: earth) @ narr         expect yes
