# «Праведные» (Камю, 1949) — исполняемый срез казуса docs/cases/les-justes.md

axis world
value world history
value world play

axis view                       # чья точка зрения: ветки морали
value view stepan
value view kaliayev
value view camus
normative_axis view

normative ought
gap ought evaluative_by_design resolved_by view
gap innocent evaluative_by_design resolved_by view

relation in_carriage(carriage, person, attempt)
relation target(attempt, person)
relation child(person)
relation oppressor(person)
relation innocent(person)
relation threw(agent, attempt)
relation killed(attempt, person)
relation offered(to, deal)
relation ought(act, attempt, agent, deal)

plane play     = world:play
plane stepan   = play + view:stepan
plane kaliayev = play + view:kaliayev
plane camus    = play + view:camus

# Факты пьесы — одни для всех веток.
fact f2: in_carriage(carriage: c1, person: grand_duke, attempt: a1) @ play [text]
fact f3: in_carriage(carriage: c1, person: nephew, attempt: a1) @ play [text]
fact f4: in_carriage(carriage: c1, person: niece, attempt: a1) @ play [text]
fact f5: child(person: nephew) @ play [text]
fact f6: child(person: niece) @ play [text]
fact f9: in_carriage(carriage: c2, person: grand_duke, attempt: a2) @ play [text]
fact t1: target(attempt: a1, person: grand_duke) @ play [text]
fact t2: target(attempt: a2, person: grand_duke) @ play [text]
fact o1: oppressor(person: grand_duke) @ play [belief_of_group]
fact p1: threw(agent: kaliayev, attempt: a2) @ play [text]
fact p2: killed(attempt: a2, person: grand_duke) @ play [text]
fact p3: offered(to: kaliayev, deal: pardon) @ play [text]

# Степан: компромисс без границы.
rule s2 defeasible @ stepan: ought(act: throw, attempt: ?a) <-
    target(attempt: ?a, person: ?t), in_carriage(person: ?t, attempt: ?a)

# Каляев, веса сняты со сцены покушения: граница — строгое основание.
rule k2 defeasible @ kaliayev: ought(act: throw, attempt: ?a) <-
    target(attempt: ?a, person: ?t), oppressor(person: ?t), in_carriage(person: ?t, attempt: ?a)
rule k1 strict @ kaliayev: ¬ought(act: throw, attempt: ?a) <-
    in_carriage(person: ?x, attempt: ?a), child(person: ?x)

# Камю, веса из «Бунтующего человека»: граница с двух сторон, жизнь за жизнь.
rule c0 strict @ camus: innocent(person: ?x) <- child(person: ?x)
rule c3 defeasible @ camus: ought(act: throw, attempt: ?a) <-
    target(attempt: ?a, person: ?t), oppressor(person: ?t), in_carriage(person: ?t, attempt: ?a)
rule c1 strict @ camus: ¬ought(act: throw, attempt: ?a) <-
    in_carriage(person: ?x, attempt: ?a), innocent(person: ?x)
rule c2 strict @ camus: ought(act: pay_with_life, agent: ?k) <-
    threw(agent: ?k, attempt: ?a), killed(attempt: ?a)
rule c4 strict @ camus: ¬ought(act: accept, agent: ?k, deal: ?d) <-
    ought(act: pay_with_life, agent: ?k), offered(to: ?k, deal: ?d)

# Воспроизведение решений.
query ought(act: throw, attempt: a1) @ stepan   expect yes
query ought(act: throw, attempt: a1) @ kaliayev expect no
query ought(act: throw, attempt: a2) @ stepan   expect yes
query ought(act: throw, attempt: a2) @ kaliayev expect yes
query ought(act: throw, attempt: a1) @ camus    expect no
query ought(act: throw, attempt: a2) @ camus    expect yes

# Отложенная сцена: тюрьма.
query ¬ought(act: accept, agent: kaliayev, deal: pardon) @ kaliayev expect unknown
query ¬ought(act: accept, agent: kaliayev, deal: pardon) @ camus    expect yes

# Без ветки норма — пробел, а не ответ.
query ought(act: throw, attempt: a1) @ play expect gap
query innocent(person: grand_duke) @ play   expect gap
