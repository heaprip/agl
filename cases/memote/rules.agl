# memote в ядре: переводимые тесты согласованности метаболической модели.
#
# Факты модели и ожидания — вердикты самого memote — пишет
# tools/memote_ref.py в файлы рядом. Здесь только правила; они должны
# поштучно повторить вердикты memote 0.17.0 (support/consistency.py):
#
#   - баланс масс и заряда — только для внутренних реакций, то есть всех,
#     кроме граничных и биомассы. Реакция, у участника которой нет формулы
#     (заряда), несбалансирована;
#   - сирота — метаболит, который во всех своих реакциях только потребляется,
#     тупик — только производится. Реакции обмена (граничные во внешнем
#     компартменте) сироту и тупик снимают. Обратимая реакция и производит, и
#     потребляет;
#   - отсоединённый — метаболит без реакций.
#
# Не переведено то, что требует линейного программирования (H38).

status curated_db > textbook

fact sv_l: side_value(side: left, value: -1) @ [textbook]
fact sv_r: side_value(side: right, value: 1) @ [textbook]

# Классы реакций. Граничная — ровно один участник (как reaction.boundary в
# cobra). Биомасса — по термину SBO:0000629. Обмен — граничная во внешнем
# компартменте или с термином SBO:0000627.
rule boundary strict @: boundary(reaction: ?r) <-
    reaction(id: ?r), ?n = count(?m) over (participates(reaction: ?r, species: ?m)), ?n = 1
rule biomass strict @: biomass(reaction: ?r) <- sbo(reaction: ?r, term: SBO_0000629)
rule exch_c strict @: exchange(reaction: ?r) <-
    boundary(reaction: ?r), participates(reaction: ?r, species: ?m),
    compartment(species: ?m, id: ?c), external(compartment: ?c)
rule exch_sbo strict @: exchange(reaction: ?r) <- boundary(reaction: ?r), sbo(reaction: ?r, term: SBO_0000627)
rule nonexch strict @: nonexchange(reaction: ?r) <-
    reaction(id: ?r), ?k = count(?r) over (exchange(reaction: ?r)), ?k = 0

# По умолчанию реакция должна сходиться; граничные и биомасса — исключения.
rule must_balance defeasible @: requires_balance(reaction: ?r) <- reaction(id: ?r)
rule ex_boundary defeasible @: ¬requires_balance(reaction: ?r) <- boundary(reaction: ?r)
rule ex_biomass defeasible @: ¬requires_balance(reaction: ?r) <- biomass(reaction: ?r)
defeats ex_boundary must_balance
defeats ex_biomass must_balance

# Баланс масс.
rule formula_n strict @: formula_count(reaction: ?r, all: ?n, known: ?k) <-
    reaction(id: ?r),
    ?n = count(?m) over (participates(reaction: ?r, species: ?m)),
    ?k = count(?m) over (participates(reaction: ?r, species: ?m), formula_known(species: ?m))
rule mass_net strict @: mass_net(reaction: ?r, element: ?e, value: ?v) <-
    formula_count(reaction: ?r, all: ?n, known: ?n), element(id: ?e),
    ?v = sum(?s * ?c * ?x) over (participates(reaction: ?r, species: ?m, side: ?side, coeff: ?c),
                                 side_value(side: ?side, value: ?s),
                                 composition(species: ?m, element: ?e, n: ?x))
rule mass_off strict @: mass_off(reaction: ?r, element: ?e) <- mass_net(reaction: ?r, element: ?e, value: ?v), ?v != 0
rule mass_ok strict @: mass_balanced(reaction: ?r) <-
    requires_balance(reaction: ?r), formula_count(reaction: ?r, all: ?n, known: ?n),
    ?k = count(?e) over (mass_off(reaction: ?r, element: ?e)), ?k = 0
rule mass_bad strict @: ¬mass_balanced(reaction: ?r) <- requires_balance(reaction: ?r), mass_off(reaction: ?r, element: ?e)
rule mass_unknown strict @: ¬mass_balanced(reaction: ?r) <-
    requires_balance(reaction: ?r), formula_count(reaction: ?r, all: ?n, known: ?k), ?k < ?n

# Баланс заряда.
rule charge_n strict @: charge_count(reaction: ?r, all: ?n, known: ?k) <-
    reaction(id: ?r),
    ?n = count(?m) over (participates(reaction: ?r, species: ?m)),
    ?k = count(?m) over (participates(reaction: ?r, species: ?m), charge(species: ?m))
rule charge_net strict @: charge_net(reaction: ?r, value: ?v) <-
    charge_count(reaction: ?r, all: ?n, known: ?n),
    ?v = sum(?s * ?c * ?q) over (participates(reaction: ?r, species: ?m, side: ?side, coeff: ?c),
                                 side_value(side: ?side, value: ?s),
                                 charge(species: ?m, value: ?q))
rule charge_ok strict @: charge_balanced(reaction: ?r) <-
    requires_balance(reaction: ?r), charge_net(reaction: ?r, value: ?v), ?v = 0
rule charge_bad strict @: ¬charge_balanced(reaction: ?r) <-
    requires_balance(reaction: ?r), charge_net(reaction: ?r, value: ?v), ?v != 0
rule charge_unknown strict @: ¬charge_balanced(reaction: ?r) <-
    requires_balance(reaction: ?r), charge_count(reaction: ?r, all: ?n, known: ?k), ?k < ?n

# Направление. Необратимая вперёд (нижняя граница ≥ 0, верхняя > 0): левые
# только потребляются, правые только производятся. Только назад (нижняя < 0,
# верхняя ≤ 0) — наоборот. Обратимая не попадает ни туда, ни сюда.
rule sub_f strict @: only_substrate(species: ?m, reaction: ?r) <-
    participates(reaction: ?r, species: ?m, side: left), bounds(reaction: ?r, lower: ?lo, upper: ?up), ?lo >= 0, ?up > 0
rule sub_r strict @: only_substrate(species: ?m, reaction: ?r) <-
    participates(reaction: ?r, species: ?m, side: right), bounds(reaction: ?r, lower: ?lo, upper: ?up), ?lo < 0, ?up <= 0
rule prod_f strict @: only_product(species: ?m, reaction: ?r) <-
    participates(reaction: ?r, species: ?m, side: right), bounds(reaction: ?r, lower: ?lo, upper: ?up), ?lo >= 0, ?up > 0
rule prod_r strict @: only_product(species: ?m, reaction: ?r) <-
    participates(reaction: ?r, species: ?m, side: left), bounds(reaction: ?r, lower: ?lo, upper: ?up), ?lo < 0, ?up <= 0

# Сколько реакций у метаболита и в скольких он только потребляется или только
# производится вне обмена.
rule usage strict @: usage(species: ?m, all: ?n, consumed: ?s, produced: ?p) <-
    species(id: ?m),
    ?n = count(?r) over (participates(reaction: ?r, species: ?m)),
    ?s = count(?r) over (only_substrate(species: ?m, reaction: ?r), nonexchange(reaction: ?r)),
    ?p = count(?r) over (only_product(species: ?m, reaction: ?r), nonexchange(reaction: ?r))

rule orphan strict @: orphan(species: ?m) <- usage(species: ?m, all: ?n, consumed: ?n), ?n > 0
rule not_orphan strict @: ¬orphan(species: ?m) <- usage(species: ?m, all: ?n, consumed: ?s), ?s < ?n
rule not_orphan0 strict @: ¬orphan(species: ?m) <- usage(species: ?m, all: 0)
rule deadend strict @: deadend(species: ?m) <- usage(species: ?m, all: ?n, produced: ?n), ?n > 0
rule not_deadend strict @: ¬deadend(species: ?m) <- usage(species: ?m, all: ?n, produced: ?p), ?p < ?n
rule not_deadend0 strict @: ¬deadend(species: ?m) <- usage(species: ?m, all: 0)
rule disc strict @: disconnected(species: ?m) <- usage(species: ?m, all: 0)
rule not_disc strict @: ¬disconnected(species: ?m) <- usage(species: ?m, all: ?n), ?n > 0
