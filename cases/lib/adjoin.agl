# Присоединение корня — один приём для любого нерешённого уравнения (H57,
# шаг 3). Элемент — многочлен a + bX; X удовлетворяет тому уравнению, которое
# не решилось в старой области: L(X) = R(X). Равенство — по модулю
# M = L − R: P ≡ 0, если P + u·M = 0 для множителя u из выборки (Коши, 1847).
#
# Данные задачи: equation(eq), eq_coef(eq, side: left|right, deg, c).
# Данные генератора: coef(p, deg, c) — элементы; mult(u, deg, c) — множители;
# probe(l, r) — пары для проверки законов; adjoined(eq) в плоскости, где
# уравнение присоединено. Без присоединения M = 0, и равенство — совпадение
# коэффициентов.

fact deg0: degree(n: 0) @
fact deg1: degree(n: 1) @
fact deg2: degree(n: 2) @
fact deg3: degree(n: 3) @

rule old strict @: old(p: ?x) <- coef(p: ?x, deg: 1, c: ?b), ?b = 0

# M = L − R присоединённого уравнения.
rule mpart strict @: m_part(side: ?s, deg: ?k, v: ?v) <-
    adjoined(eq: ?e), eq_coef(eq: ?e, side: ?s, deg: ?k, c: ?c), sign(side: ?s, s: ?g), ?v = ?g * ?c
rule mc strict @: m(deg: ?k, c: ?c) <-
    degree(n: ?k), ?c = sum(?v) over (m_part(side: ?s, deg: ?k, v: ?v))

# Закон распределения: произведение Коши. Квадрат каждого элемента и
# произведения проб.
rule sqt strict @: term(kind: sq, a: ?x, b: ?x, i: ?i, j: ?j, deg: ?k, v: ?v) <-
    coef(p: ?x, deg: ?i, c: ?p), coef(p: ?x, deg: ?j, c: ?q), ?k = ?i + ?j, ?v = ?p * ?q
rule prt strict @: term(kind: prod, a: ?x, b: ?y, i: ?i, j: ?j, deg: ?k, v: ?v) <-
    probe(l: ?x, r: ?y), coef(p: ?x, deg: ?i, c: ?p), coef(p: ?y, deg: ?j, c: ?q),
    ?k = ?i + ?j, ?v = ?p * ?q
rule tsum strict @: mul(kind: ?n, a: ?x, b: ?y, deg: ?k, c: ?c) <-
    term(kind: ?n, a: ?x, b: ?y), degree(n: ?k),
    ?c = sum(?v) over (term(kind: ?n, a: ?x, b: ?y, i: ?i, j: ?j, deg: ?k, v: ?v))
rule ut strict @: uterm(u: ?u, i: ?i, j: ?j, deg: ?k, v: ?v) <-
    mult(u: ?u, deg: ?i, c: ?p), m(deg: ?j, c: ?q), ?k = ?i + ?j, ?v = ?p * ?q
rule usum strict @: um(u: ?u, deg: ?k, c: ?c) <-
    mult(u: ?u), degree(n: ?k), ?c = sum(?v) over (uterm(u: ?u, i: ?i, j: ?j, deg: ?k, v: ?v))
rule uvec strict @: um_vec(u: ?u, c0: ?a, c1: ?b, c2: ?c, c3: ?d) <-
    um(u: ?u, deg: 0, c: ?a), um(u: ?u, deg: 1, c: ?b), um(u: ?u, deg: 2, c: ?c),
    um(u: ?u, deg: 3, c: ?d)

# Многочлены, которые проверяются на ноль.
# Сам элемент.
rule pel strict @: part(kind: elem, a: ?x, b: ?x, src: self, deg: ?k, v: ?c) <- coef(p: ?x, deg: ?k, c: ?c)
# Произведение пробы.
rule ppr strict @: part(kind: prod, a: ?x, b: ?y, src: self, deg: ?k, v: ?c) <-
    mul(kind: prod, a: ?x, b: ?y, deg: ?k, c: ?c)
# Разность двух старых элементов.
rule pdl strict @: part(kind: diff, a: ?x, b: ?y, src: first, deg: ?k, v: ?c) <-
    old(p: ?x), old(p: ?y), ?x != ?y, coef(p: ?x, deg: ?k, c: ?c)
rule pdr strict @: part(kind: diff, a: ?x, b: ?y, src: second, deg: ?k, v: ?v) <-
    old(p: ?x), old(p: ?y), ?x != ?y, coef(p: ?y, deg: ?k, c: ?c), ?v = 0 - ?c
# L(e) − R(e): подстановка элемента в уравнение.
rule ps0 strict @: part(kind: sol, a: ?x, b: ?e, src: ?s, deg: 0, v: ?v) <-
    equation(eq: ?e), coef(p: ?x, deg: 0), eq_coef(eq: ?e, side: ?s, deg: 0, c: ?c),
    sign(side: ?s, s: ?g), ?v = ?g * ?c
rule ps1 strict @: part(kind: sol, a: ?x, b: ?e, src: ?t, deg: ?k, v: ?v) <-
    equation(eq: ?e), coef(p: ?x, deg: ?k, c: ?p), eq_coef(eq: ?e, side: ?s, deg: 1, c: ?c),
    sign(side: ?s, s: ?g, x1: ?t), ?v = ?g * ?c * ?p
rule ps2 strict @: part(kind: sol, a: ?x, b: ?e, src: ?t, deg: ?k, v: ?v) <-
    equation(eq: ?e), mul(kind: sq, a: ?x, b: ?x, deg: ?k, c: ?p),
    eq_coef(eq: ?e, side: ?s, deg: 2, c: ?c), sign(side: ?s, s: ?g, x2: ?t), ?v = ?g * ?c * ?p
# Знак стороны и метки слагаемых: агрегат суммирует различные решения, и
# равные слагаемые из разных источников не должны слиться.
fact sl: sign(side: left, s: 1, x1: left_x, x2: left_xx) @
fact sr: sign(side: right, s: -1, x1: right_x, x2: right_xx) @

rule pc strict @: pcoef(kind: ?n, a: ?x, b: ?y, deg: ?k, c: ?c) <-
    part(kind: ?n, a: ?x, b: ?y), degree(n: ?k),
    ?c = sum(?v) over (part(kind: ?n, a: ?x, b: ?y, src: ?s, deg: ?k, v: ?v))
# P ≡ 0, если P = −u·M для какого-то u.
rule zero strict @: zero(kind: ?n, a: ?x, b: ?y) <-
    pcoef(kind: ?n, a: ?x, b: ?y, deg: 0, c: ?p0), pcoef(kind: ?n, a: ?x, b: ?y, deg: 1, c: ?p1),
    pcoef(kind: ?n, a: ?x, b: ?y, deg: 2, c: ?p2), pcoef(kind: ?n, a: ?x, b: ?y, deg: 3, c: ?p3),
    ?q0 = 0 - ?p0, ?q1 = 0 - ?p1, ?q2 = 0 - ?p2, ?q3 = 0 - ?p3,
    um_vec(u: ?u, c0: ?q0, c1: ?q1, c2: ?q2, c3: ?q3)

# Сито (1): уравнение решено.
rule solves strict @: solution(eq: ?e, p: ?x) <- zero(kind: sol, a: ?x, b: ?e)
rule solvable strict @: solvable(eq: ?e) <- solution(eq: ?e, p: ?x)

# Сито (2): консервативность — разные старые элементы не стали равны.
rule cons strict @: law_broken(law: conservative, a: ?x, b: ?y) <- zero(kind: diff, a: ?x, b: ?y)

# Сито (3): нет делителей нуля.
rule nzc strict @: zero_count(p: ?x, n: ?c) <-
    coef(p: ?x, deg: 0), ?c = count(?x) over (zero(kind: elem, a: ?x, b: ?x))
rule zdiv strict @: law_broken(law: cancellation, a: ?x, b: ?y) <-
    zero(kind: prod, a: ?x, b: ?y), zero_count(p: ?x, n: 0), zero_count(p: ?y, n: 0)
