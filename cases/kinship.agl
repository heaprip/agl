# Родство: разложение понятий (H42, H44) рядом с выводом. Бумажная часть —
# docs/cases/kinship.md.
#
# Понятие (concept) задаётся необходимым и достаточным условием. Ядро и узнаёт
# его в данных, и сравнивает понятия по определениям, без данных (compare).
# Термины языков (word) — имена понятий; понятия от языка не зависят.
#
# Плоскости: генетическая и вынашивания (обе биологические) и правовая.
# Обычная семья записана в корне — в ней все аспекты совпадают. Где аспекты
# расходятся (усыновление, суррогатное материнство), факты стоят в своих
# плоскостях. Бытовая плоскость видит все аспекты сразу.

axis aspect
value aspect bio
value aspect genetic in bio
value aspect gestation in bio
value aspect law
overlap aspect genetic gestation
overlap aspect bio law

plane bio = aspect:bio
plane genetic = aspect:genetic
plane gestation = aspect:gestation
plane law = aspect:law
plane everyday = aspect:genetic + aspect:gestation + aspect:law

# Простые отношения.
relation parenthood(child, parent)
relation marriage(person, spouse)
relation female(person)
relation male(person)
relation birth(child, mother)
cover female(person) | male(person)

# Уровень 1: родитель, ребёнок, супруг.
concept parent(ego: ?e, alter: ?a) @: parenthood(child: ?e, parent: ?a)
concept child(ego: ?e, alter: ?a) @: parenthood(child: ?a, parent: ?e)
concept spouse(ego: ?e, alter: ?a) @: marriage(person: ?e, spouse: ?a)

# Уровень 2: пол.
concept mother(ego: ?e, alter: ?a) @: parent(ego: ?e, alter: ?a), female(person: ?a)
concept father(ego: ?e, alter: ?a) @: parent(ego: ?e, alter: ?a), male(person: ?a)
concept son(ego: ?e, alter: ?a) @: child(ego: ?e, alter: ?a), male(person: ?a)
concept daughter(ego: ?e, alter: ?a) @: child(ego: ?e, alter: ?a), female(person: ?a)
concept husband(ego: ?e, alter: ?a) @: spouse(ego: ?e, alter: ?a), male(person: ?a)
concept wife(ego: ?e, alter: ?a) @: spouse(ego: ?e, alter: ?a), female(person: ?a)

# В плоскости вынашивания у матери есть второй смысл: та, кто родила.
concept mother(ego: ?e, alter: ?a) @ gestation: birth(child: ?e, mother: ?a)

# Уровень 3: братья и сёстры, деды, внуки.
concept sibling(ego: ?e, alter: ?a) @: parent(ego: ?e, alter: ?p), child(ego: ?p, alter: ?a), ?a != ?e
concept brother(ego: ?e, alter: ?a) @: sibling(ego: ?e, alter: ?a), male(person: ?a)
concept sister(ego: ?e, alter: ?a) @: sibling(ego: ?e, alter: ?a), female(person: ?a)
concept grandparent(ego: ?e, alter: ?a) @: parent(ego: ?e, alter: ?p), parent(ego: ?p, alter: ?a)
concept grandfather(ego: ?e, alter: ?a) @: grandparent(ego: ?e, alter: ?a), male(person: ?a)
concept grandmother(ego: ?e, alter: ?a) @: grandparent(ego: ?e, alter: ?a), female(person: ?a)
concept grandchild(ego: ?e, alter: ?a) @: child(ego: ?e, alter: ?c), child(ego: ?c, alter: ?a)
concept grandson(ego: ?e, alter: ?a) @: grandchild(ego: ?e, alter: ?a), male(person: ?a)

# Уровень 4: дяди, тёти, двоюродные.
concept uncle_blood(ego: ?e, alter: ?a) @: parent(ego: ?e, alter: ?p), brother(ego: ?p, alter: ?a)
concept aunt_blood(ego: ?e, alter: ?a) @: parent(ego: ?e, alter: ?p), sister(ego: ?p, alter: ?a)
concept aunt_husband(ego: ?e, alter: ?a) @: aunt_blood(ego: ?e, alter: ?t), husband(ego: ?t, alter: ?a)
concept uncle_wife(ego: ?e, alter: ?a) @: uncle_blood(ego: ?e, alter: ?u), wife(ego: ?u, alter: ?a)
concept uncle(ego: ?e, alter: ?a) @: uncle_blood(ego: ?e, alter: ?a)
concept uncle(ego: ?e, alter: ?a) @: aunt_husband(ego: ?e, alter: ?a)
concept aunt(ego: ?e, alter: ?a) @: aunt_blood(ego: ?e, alter: ?a)
concept aunt(ego: ?e, alter: ?a) @: uncle_wife(ego: ?e, alter: ?a)
concept mothers_brother(ego: ?e, alter: ?a) @: mother(ego: ?e, alter: ?m), brother(ego: ?m, alter: ?a)
concept fathers_brother(ego: ?e, alter: ?a) @: father(ego: ?e, alter: ?f), brother(ego: ?f, alter: ?a)
concept mothers_sister(ego: ?e, alter: ?a) @: mother(ego: ?e, alter: ?m), sister(ego: ?m, alter: ?a)
concept fathers_sister(ego: ?e, alter: ?a) @: father(ego: ?e, alter: ?f), sister(ego: ?f, alter: ?a)
concept cousin(ego: ?e, alter: ?a) @: parent(ego: ?e, alter: ?p), sibling(ego: ?p, alter: ?s), child(ego: ?s, alter: ?a)
concept male_cousin(ego: ?e, alter: ?a) @: cousin(ego: ?e, alter: ?a), male(person: ?a)
concept brother_mother(ego: ?e, alter: ?a) @: brother(ego: ?e, alter: ?b), mother(ego: ?b, alter: ?a)

# Свойство: родители и братья супругов, супруги детей и сестёр.
concept spouse_father(ego: ?e, alter: ?a) @: spouse(ego: ?e, alter: ?s), father(ego: ?s, alter: ?a)
concept spouse_mother(ego: ?e, alter: ?a) @: spouse(ego: ?e, alter: ?s), mother(ego: ?s, alter: ?a)
concept wife_father(ego: ?e, alter: ?a) @: wife(ego: ?e, alter: ?w), father(ego: ?w, alter: ?a)
concept wife_mother(ego: ?e, alter: ?a) @: wife(ego: ?e, alter: ?w), mother(ego: ?w, alter: ?a)
concept husband_father(ego: ?e, alter: ?a) @: husband(ego: ?e, alter: ?h), father(ego: ?h, alter: ?a)
concept husband_mother(ego: ?e, alter: ?a) @: husband(ego: ?e, alter: ?h), mother(ego: ?h, alter: ?a)
concept husband_brother(ego: ?e, alter: ?a) @: husband(ego: ?e, alter: ?h), brother(ego: ?h, alter: ?a)
concept wife_brother(ego: ?e, alter: ?a) @: wife(ego: ?e, alter: ?w), brother(ego: ?w, alter: ?a)
concept daughter_husband(ego: ?e, alter: ?a) @: daughter(ego: ?e, alter: ?d), husband(ego: ?d, alter: ?a)
concept sister_husband(ego: ?e, alter: ?a) @: sister(ego: ?e, alter: ?s), husband(ego: ?s, alter: ?a)
concept zyat(ego: ?e, alter: ?a) @: daughter_husband(ego: ?e, alter: ?a)
concept zyat(ego: ?e, alter: ?a) @: sister_husband(ego: ?e, alter: ?a)
concept brother_in_law(ego: ?e, alter: ?a) @: spouse(ego: ?e, alter: ?s), brother(ego: ?s, alter: ?a)
concept brother_in_law(ego: ?e, alter: ?a) @: sister_husband(ego: ?e, alter: ?a)
# Отчим — муж матери, который не отец. «Не» определение без отрицания не
# выражает: это только муж матери, и в него попадает отец.
concept mother_husband(ego: ?e, alter: ?a) @: mother(ego: ?e, alter: ?m), husband(ego: ?m, alter: ?a)

word ru родитель = parent
word ru мать = mother
word ru отец = father
word ru ребёнок = child
word ru сын = son
word ru дочь = daughter
word ru брат = brother
word ru сестра = sister
word ru дед = grandfather
word ru бабушка = grandmother
word ru внук = grandson
word ru дядя = uncle
word ru тётя = aunt
word ru двоюродный_брат = male_cousin
word ru супруг = spouse
word ru муж = husband
word ru жена = wife
word ru тесть = wife_father
word ru тёща = wife_mother
word ru свёкор = husband_father
word ru свекровь = husband_mother
word ru деверь = husband_brother
word ru шурин = wife_brother
word ru зять = zyat

word en parent = parent
word en mother = mother
word en father = father
word en child = child
word en son = son
word en daughter = daughter
word en brother = brother
word en sister = sister
word en sibling = sibling
word en grandparent = grandparent
word en grandfather = grandfather
word en grandmother = grandmother
word en grandson = grandson
word en uncle = uncle
word en aunt = aunt
word en cousin = cousin
word en spouse = spouse
word en husband = husband
word en wife = wife
word en father-in-law = spouse_father
word en mother-in-law = spouse_mother
word en son-in-law = daughter_husband
word en brother-in-law = brother_in_law

word la parens = parent
word la mater = mother
word la pater = father
word la filius = son
word la filia = daughter
word la frater = brother
word la soror = sister
word la avus = grandfather
word la avia = grandmother
word la patruus = fathers_brother
word la avunculus = mothers_brother
word la amita = fathers_sister
word la matertera = mothers_sister
word la maritus = husband
word la uxor = wife
word la socer = spouse_father
word la socrus = spouse_mother
word la gener = daughter_husband
word la levir = husband_brother

# Вывод: правила о мире, а не определения. Предок рекурсивен, поэтому он
# правило, а не понятие.
rule msym strict @: marriage(person: ?b, spouse: ?a) <- marriage(person: ?a, spouse: ?b)
rule anc1 strict @: ancestor(ego: ?e, alter: ?a) <- parenthood(child: ?e, parent: ?a)
rule anc2 strict @: ancestor(ego: ?e, alter: ?a) <- parenthood(child: ?e, parent: ?p), ancestor(ego: ?p, alter: ?a)
rule bl1 strict @: blood(ego: ?e, alter: ?a) <- ancestor(ego: ?e, alter: ?a)
rule bl2 strict @: blood(ego: ?e, alter: ?a) <- ancestor(ego: ?a, alter: ?e)
rule bl3 strict @: blood(ego: ?e, alter: ?a) <- ancestor(ego: ?e, alter: ?c), ancestor(ego: ?a, alter: ?c), ?e != ?a
rule il1 strict @: in_law(ego: ?e, alter: ?a) <- marriage(person: ?e, spouse: ?s), blood(ego: ?s, alter: ?a)
rule il2 strict @: in_law(ego: ?e, alter: ?a) <- blood(ego: ?e, alter: ?r), marriage(person: ?r, spouse: ?a)
# Логическая сторона: никто не предок самому себе.
rule loop strict @: own_ancestor(person: ?a) <- ancestor(ego: ?a, alter: ?a)
forbid own_ancestor(person: ?a) @

# Кто занимает роли — своя цепочка вверх в каждой плоскости.
rule ps1 strict @: person(id: ?x) <- parenthood(child: ?x)
rule ps2 strict @: person(id: ?x) <- parenthood(parent: ?x)
rule ps3 strict @: person(id: ?x) <- marriage(person: ?x)
rule ps4 strict @: person(id: ?x) <- birth(mother: ?x)
rule tx0 strict @ bio: member(id: ?x, taxon: homo_sapiens) <- person(id: ?x)
rule tx1 strict @ bio: member(id: ?x, taxon: ?p) <- member(id: ?x, taxon: ?t), within(taxon: ?t, parent: ?p)
fact w1: within(taxon: homo_sapiens, parent: homo) @ bio [ncbi_taxonomy]
fact w2: within(taxon: homo, parent: hominidae) @ bio [ncbi_taxonomy]
fact w3: within(taxon: hominidae, parent: primates) @ bio [ncbi_taxonomy]
fact w4: within(taxon: primates, parent: mammalia) @ bio [ncbi_taxonomy]
fact w5: within(taxon: mammalia, parent: chordata) @ bio [ncbi_taxonomy]
fact w6: within(taxon: chordata, parent: metazoa) @ bio [ncbi_taxonomy]
fact w7: within(taxon: metazoa, parent: eukaryota) @ bio [ncbi_taxonomy]
fact w8: within(taxon: eukaryota, parent: cellular_organisms) @ bio [ncbi_taxonomy]
rule alive strict @ bio: living(id: ?x) <- member(id: ?x, taxon: cellular_organisms)
rule np strict @ law: natural_person(id: ?x) <- person(id: ?x)
rule sl strict @ law: subject_of_law(id: ?x) <- natural_person(id: ?x)

# В одной плоскости у человека одна мать.
unique mother(alter) by (ego)

# Обычная семья: все аспекты совпадают.
fact f1: parenthood(child: ivan, parent: semyon) @
fact f2: parenthood(child: ivan, parent: darya) @
fact f3: parenthood(child: maria, parent: boris) @
fact f4: parenthood(child: maria, parent: galina) @
fact f5: parenthood(child: oleg, parent: boris) @
fact f6: parenthood(child: oleg, parent: galina) @
fact f7: parenthood(child: petr, parent: ivan) @
fact f8: parenthood(child: petr, parent: maria) @
fact f9: parenthood(child: anna, parent: ivan) @
fact f10: parenthood(child: anna, parent: maria) @
fact m1: marriage(person: ivan, spouse: maria) @
fact m2: marriage(person: anna, spouse: kirill) @
fact s1: male(person: semyon) @
fact s2: female(person: darya) @
fact s3: male(person: boris) @
fact s4: female(person: galina) @
fact s5: male(person: ivan) @
fact s6: female(person: maria) @
fact s7: male(person: oleg) @
fact s8: male(person: petr) @
fact s9: female(person: anna) @
fact s10: male(person: kirill) @

# Усыновление: Лев рождён Тамарой и Русланом, усыновлён Еленой и Николаем.
fact a1: parenthood(child: lev, parent: tamara) @ genetic
fact a2: parenthood(child: lev, parent: ruslan) @ genetic
fact a3: birth(child: lev, mother: tamara) @ gestation
fact a4: parenthood(child: lev, parent: elena) @ law
fact a5: parenthood(child: lev, parent: nikolai) @ law
fact a6: female(person: tamara) @
fact a7: male(person: ruslan) @
fact a8: female(person: elena) @
fact a9: male(person: nikolai) @

# Суррогатное материнство: яйцеклетка Инны, выносила Вера, мать по закону —
# Ольга. Отец Павел — во всех аспектах.
fact r1: parenthood(child: mira, parent: inna) @ genetic
fact r2: birth(child: mira, mother: vera) @ gestation
fact r3: parenthood(child: mira, parent: olga) @ law
fact r4: parenthood(child: mira, parent: pavel) @
fact r5: female(person: inna) @
fact r6: female(person: vera) @
fact r7: female(person: olga) @
fact r8: male(person: pavel) @

# Узнавание в данных.
query uncle(ego: petr, alter: oleg) @ expect yes
query mothers_brother(ego: petr, alter: oleg) @ expect yes
query wife_mother(ego: ivan, alter: galina) @ expect yes
query husband_father(ego: maria, alter: semyon) @ expect yes
query wife_father(ego: kirill, alter: ivan) @ expect yes
query zyat(ego: ivan, alter: kirill) @ expect yes
query brother_in_law(ego: kirill, alter: petr) @ expect yes
query grandfather(ego: petr, alter: boris) @ expect yes
query blood(ego: petr, alter: oleg) @ expect yes
query in_law(ego: ivan, alter: galina) @ expect yes
query in_law(ego: petr, alter: oleg) @ expect unknown

# Плоскости: чья мать.
query mother(ego: lev, alter: tamara) @ genetic expect yes
query mother(ego: lev, alter: tamara) @ gestation expect yes
query mother(ego: lev, alter: tamara) @ law expect unknown
query mother(ego: lev, alter: elena) @ law expect yes
query mother(ego: lev, alter: elena) @ genetic expect unknown
query mother(ego: mira, alter: inna) @ genetic expect yes
query mother(ego: mira, alter: vera) @ gestation expect yes
query mother(ego: mira, alter: inna) @ gestation expect unknown
query mother(ego: mira, alter: olga) @ law expect yes
query mother(ego: mira, alter: vera) @ everyday expect yes
query father(ego: mira, alter: pavel) @ everyday expect yes

# Вверх по плоскостям: кто занимает роль.
query living(id: galina) @ bio expect yes
query living(id: galina) @ law expect unknown
query subject_of_law(id: galina) @ law expect yes
query subject_of_law(id: galina) @ bio expect unknown

# Сравнение по определениям, без данных.
compare mother @ vs parent @ expect below
compare mothers_brother @ vs uncle @ expect below
compare uncle @ vs mothers_brother @ expect above
compare brother_mother @ vs mother @ expect apart
compare wife_father @ vs husband_father @ expect apart
compare wife_father @ vs spouse_father @ expect below
compare grandfather @ vs grandparent @ expect below
compare male_cousin @ vs cousin @ expect below
compare mother_husband @ vs husband @ expect apart

# Против правил: понятие под отношением, которое выводится.
compare mother @ vs ancestor @ expect below
compare grandfather @ vs ancestor @ expect below
compare mother_husband @ vs ancestor @ expect not_below
# Находка ядра: по определению человек бывает сам себе дядей и двоюродным
# братом — если его родители брат и сестра или родитель приходится ему и дедом.
# Кровным родственником самого себя правило bl3 его не считает, поэтому не
# «ниже». Исключить себя из определений или нет — выбор автора.
compare uncle_blood @ vs blood @ expect not_below
compare uncle @ vs blood @ expect not_below
compare cousin @ vs blood @ expect not_below
compare wife_mother @ vs in_law @ expect below
compare wife_mother @ vs blood @ expect not_below
compare zyat @ vs in_law @ expect below

# Между плоскостями.
compare mother @ genetic vs mother @ law expect apart
compare mother @ gestation vs mother @ genetic expect apart
compare mother @ vs mother @ everyday expect below
compare mother @ vs mother @ gestation expect below
# Мать, которая выносила, — не родитель по `parenthood`: в плоскости
# вынашивания «мать» уже не частный случай «родителя».
compare mother @ gestation vs parent @ gestation expect apart
compare mother @ genetic vs parent @ genetic expect below
