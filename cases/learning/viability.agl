# Обучение: найти, что делает систему жизнеспособной, не имея правила.
#
# Мир — без правил жизнеспособности. Учебная задача — отношение `viable` и его
# примеры. Обучение — только на бескислородной плоскости; кислородная плоскость
# и контексты с `situate` — отложенные (heldout): гипотеза их не видит, а
# потом проверяется на них.
#
#   agl --learn viable cases/learning/viability.agl

include ../trunk/oxygen-world.agl

query viable(system: fermenting) @ anaerobic      expect yes
query viable(system: respiring) @ anaerobic       expect no
query viable(system: glycolysis_only) @ anaerobic expect no

query viable(system: fermenting) @ aerobic        expect yes heldout
query viable(system: respiring) @ aerobic         expect yes heldout
query viable(system: glycolysis_only) @ aerobic   expect no heldout
query viable(system: respiring) @ situate everest_sprint expect no heldout
query viable(system: respiring) @ situate everest_rest   expect yes heldout
query viable(system: respiring) @ situate sea_sprint     expect yes heldout
