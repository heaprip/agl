# Слепая проверка (H57, шаг 3): i. Уравнение x² = −1 не решается в целых.
# Написано после заморозки библиотеки (f6cb9dc).

fact eq: equation(eq: root_minus_one) @ [textbook]
fact l2: eq_coef(eq: root_minus_one, side: left, deg: 2, c: 1) @ [textbook]
fact r0: eq_coef(eq: root_minus_one, side: right, deg: 0, c: -1) @ [textbook]
fact dom: domain(lo: -4, hi: 4) @

query solvable(eq: root_minus_one) @ expect yes

include ../../lib/adjoin.agl
