# Отрицательные числа: 3 − 5 в натуральных. Уравнение x + 5 = 3 не решается
# среди 0, 1, 2, … Приём присоединения — общий: lib/adjoin.agl (H57, шаг 3).

fact eq: equation(eq: minus) @ [textbook]
fact l1: eq_coef(eq: minus, side: left, deg: 1, c: 1) @ [textbook]
fact l0: eq_coef(eq: minus, side: left, deg: 0, c: 5) @ [textbook]
fact r0: eq_coef(eq: minus, side: right, deg: 0, c: 3) @ [textbook]
# Старая область для генератора: натуральные от 0.
fact dom: domain(lo: 0, hi: 8) @

query solvable(eq: minus) @ expect yes

include ../../lib/adjoin.agl
