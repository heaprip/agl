include ../../../../cases/trunk/lib.agl

# Ферментации и дыхательная цепь: как клетка возвращает NAD+ и что это даёт
# по ATP. Ствол даёт гликолиз (pathway glycolysis), лактатдегидрогеназу
# (RHEA_23444), составы веществ и проверку баланса. Дрожжевые реакции и
# бухгалтерия путей объявлены здесь.

axis oxygen
value oxygen present
value oxygen absent

plane aerobic   = oxygen:present
plane anaerobic = oxygen:absent

# --- Новые вещества -------------------------------------------------------
# ChEBI:15343 ацетальдегид, ChEBI:16236 этанол, ChEBI:16526 углекислый газ.
fact fk_15343: formula_known(species: CHEBI_15343) @ [llm_proposal]
fact co_15343_C: composition(species: CHEBI_15343, element: C, n: 2) @ [llm_proposal]
fact co_15343_H: composition(species: CHEBI_15343, element: H, n: 4) @ [llm_proposal]
fact co_15343_O: composition(species: CHEBI_15343, element: O, n: 1) @ [llm_proposal]
fact co_15343_ch: composition(species: CHEBI_15343, element: charge, n: 0) @ [llm_proposal]
fact top_15343: top(species: CHEBI_15343) @ [llm_proposal]

fact fk_16236: formula_known(species: CHEBI_16236) @ [llm_proposal]
fact co_16236_C: composition(species: CHEBI_16236, element: C, n: 2) @ [llm_proposal]
fact co_16236_H: composition(species: CHEBI_16236, element: H, n: 6) @ [llm_proposal]
fact co_16236_O: composition(species: CHEBI_16236, element: O, n: 1) @ [llm_proposal]
fact co_16236_ch: composition(species: CHEBI_16236, element: charge, n: 0) @ [llm_proposal]
fact top_16236: top(species: CHEBI_16236) @ [llm_proposal]

fact fk_16526: formula_known(species: CHEBI_16526) @ [llm_proposal]
fact co_16526_C: composition(species: CHEBI_16526, element: C, n: 1) @ [llm_proposal]
fact co_16526_O: composition(species: CHEBI_16526, element: O, n: 2) @ [llm_proposal]
fact co_16526_ch: composition(species: CHEBI_16526, element: charge, n: 0) @ [llm_proposal]
fact top_16526: top(species: CHEBI_16526) @ [llm_proposal]

# --- Реакции --------------------------------------------------------------
# Пируватдекарбоксилаза (EC 4.1.1.1), дрожжи: пируват + H+ = ацетальдегид + CO2.
# Rhea-записи в стволе нет, идентификатор синтетический.
fact pdc_rx: reaction(id: pyruvate_decarboxylase) @ [llm_proposal]
fact pdc_1: participates(reaction: pyruvate_decarboxylase, species: CHEBI_15361, side: left, coeff: 1) @ [llm_proposal]
fact pdc_2: participates(reaction: pyruvate_decarboxylase, species: CHEBI_15378, side: left, coeff: 1) @ [llm_proposal]
fact pdc_3: participates(reaction: pyruvate_decarboxylase, species: CHEBI_15343, side: right, coeff: 1) @ [llm_proposal]
fact pdc_4: participates(reaction: pyruvate_decarboxylase, species: CHEBI_16526, side: right, coeff: 1) @ [llm_proposal]

# Алкогольдегидрогеназа (EC 1.1.1.1), дрожжи:
# ацетальдегид + NADH + H+ = этанол + NAD+.
fact adh_rx: reaction(id: alcohol_dehydrogenase) @ [llm_proposal]
fact adh_1: participates(reaction: alcohol_dehydrogenase, species: CHEBI_15343, side: left, coeff: 1) @ [llm_proposal]
fact adh_2: participates(reaction: alcohol_dehydrogenase, species: CHEBI_57945, side: left, coeff: 1) @ [llm_proposal]
fact adh_3: participates(reaction: alcohol_dehydrogenase, species: CHEBI_15378, side: left, coeff: 1) @ [llm_proposal]
fact adh_4: participates(reaction: alcohol_dehydrogenase, species: CHEBI_16236, side: right, coeff: 1) @ [llm_proposal]
fact adh_5: participates(reaction: alcohol_dehydrogenase, species: CHEBI_57540, side: right, coeff: 1) @ [llm_proposal]

# Дыхательная цепь, укрупнённо: 2 NADH + 2 H+ + O2 = 2 NAD+ + 2 H2O.
# (Та же сумма, что etc_lumped в казусе кислорода; здесь свой id.)
fact rc_rx: reaction(id: rc_lumped) @ [llm_proposal]
fact rc_1: participates(reaction: rc_lumped, species: CHEBI_57945, side: left, coeff: 2) @ [llm_proposal]
fact rc_2: participates(reaction: rc_lumped, species: CHEBI_15378, side: left, coeff: 2) @ [llm_proposal]
fact rc_3: participates(reaction: rc_lumped, species: CHEBI_15379, side: left, coeff: 1) @ [llm_proposal]
fact rc_4: participates(reaction: rc_lumped, species: CHEBI_57540, side: right, coeff: 2) @ [llm_proposal]
fact rc_5: participates(reaction: rc_lumped, species: CHEBI_15377, side: right, coeff: 2) @ [llm_proposal]

# --- Пути -----------------------------------------------------------------
# Лактатная ферментация: 2 пирувата восстанавливаются до 2 лактата, NADH
# окисляется обратно в NAD+.
fact pw_lf: pathway(id: lactate_fermentation) @ [llm_proposal]
fact lf_1: step(pathway: lactate_fermentation, reaction: RHEA_23444, direction: reverse, times: 2) @ [llm_proposal]

# Спиртовая ферментация: 2 пирувата -> 2 ацетальдегида + 2 CO2,
# затем 2 ацетальдегида -> 2 этанола.
fact pw_af: pathway(id: alcohol_fermentation) @ [llm_proposal]
fact af_1: step(pathway: alcohol_fermentation, reaction: pyruvate_decarboxylase, direction: forward, times: 2) @ [llm_proposal]
fact af_2: step(pathway: alcohol_fermentation, reaction: alcohol_dehydrogenase, direction: forward, times: 2) @ [llm_proposal]

fact pw_rc: pathway(id: nadh_oxidation) @ [llm_proposal]
fact rc_1_step: step(pathway: nadh_oxidation, reaction: rc_lumped, direction: forward, times: 1) @ [llm_proposal]

# --- Системы-кандидаты ----------------------------------------------------
fact sy_gl: system(id: glycolysis_only) @ [llm_proposal]
fact u_gl1: uses(system: glycolysis_only, pathway: glycolysis, times: 1) @ [llm_proposal]

fact sy_lf: system(id: muscle_lactate) @ [llm_proposal]
fact u_lf1: uses(system: muscle_lactate, pathway: glycolysis, times: 1) @ [llm_proposal]
fact u_lf2: uses(system: muscle_lactate, pathway: lactate_fermentation, times: 1) @ [llm_proposal]

fact sy_af: system(id: yeast_alcohol) @ [llm_proposal]
fact u_af1: uses(system: yeast_alcohol, pathway: glycolysis, times: 1) @ [llm_proposal]
fact u_af2: uses(system: yeast_alcohol, pathway: alcohol_fermentation, times: 1) @ [llm_proposal]

fact sy_rc: system(id: respiring) @ [llm_proposal]
fact u_rc1: uses(system: respiring, pathway: glycolysis, times: 1) @ [llm_proposal]
fact u_rc2: uses(system: respiring, pathway: nadh_oxidation, times: 1) @ [llm_proposal]

# --- Что даёт среда -------------------------------------------------------
# NAD+ среда не даёт: он должен сойтись в ноль внутри системы (как в казусе
# кислорода). Кислород есть только в аэробной плоскости.
fact av_glc: available(species: CHEBI_4167) @ [llm_proposal]
fact av_adp: available(species: CHEBI_456216) @ [llm_proposal]
fact av_pi:  available(species: CHEBI_43474) @ [llm_proposal]
fact av_h:   available(species: CHEBI_15378) @ [llm_proposal]
fact av_o2:  available(species: CHEBI_15379) @ aerobic [llm_proposal]

# --- Бухгалтерия ----------------------------------------------------------
# Сколько вещества путь/система даёт (+) или забирает (−). Агрегат сворачивает
# различные решения, поэтому от порядка утверждений не зависит; пустая сумма —
# 0, то есть «путь этого вещества не трогает».

rule path_net strict @: path_net(pathway: ?p, species: ?x, value: ?v) <-
    pathway(id: ?p), top(species: ?x),
    ?v = sum(?t * ?d * ?sv * ?c) over (step(pathway: ?p, reaction: ?r, direction: ?dir, times: ?t),
                                       dir_value(direction: ?dir, value: ?d),
                                       participates(reaction: ?r, species: ?x, side: ?side, coeff: ?c),
                                       side_value(side: ?side, value: ?sv))

rule sys_net strict @: sys_net(system: ?s, species: ?x, value: ?v) <-
    system(id: ?s), top(species: ?x),
    ?v = sum(?u * ?t * ?d * ?sv * ?c) over (uses(system: ?s, pathway: ?p, times: ?u),
                                           step(pathway: ?p, reaction: ?r, direction: ?dir, times: ?t),
                                           dir_value(direction: ?dir, value: ?d),
                                           participates(reaction: ?r, species: ?x, side: ?side, coeff: ?c),
                                           side_value(side: ?side, value: ?sv))

rule needs strict @: needs(system: ?s, species: ?x) <-
    sys_net(system: ?s, species: ?x, value: ?v), ?v < 0

rule supplied strict @: supplied(system: ?s, species: ?x) <-
    needs(system: ?s, species: ?x), available(species: ?x)

rule lacking strict @: lacking(system: ?s, species: ?x) <-
    needs(system: ?s, species: ?x), ?k = count(?x) over (available(species: ?x)), ?k = 0

rule works strict @: works(system: ?s) <-
    system(id: ?s),
    ?c = count(?x) over (needs(system: ?s, species: ?x)),
    ?a = count(?x) over (supplied(system: ?s, species: ?x)),
    ?c = ?a

rule not_works strict @: ¬works(system: ?s) <- lacking(system: ?s, species: ?x)

# NAD+ возвращается тем путём системы, который сам тратит NADH, при условии,
# что система работает целиком (то есть у неё есть всё потребляемое).
rule regen strict @: regenerates_NAD(system: ?s, pathway: ?p) <-
    works(system: ?s),
    uses(system: ?s, pathway: ?p, times: ?u),
    path_net(pathway: ?p, species: CHEBI_57945, value: ?v), ?v < 0,
    sys_net(system: ?s, species: CHEBI_57540, value: 0),
    sys_net(system: ?s, species: CHEBI_57945, value: 0)

# Без кислорода путь, который его тратит, NAD+ вернуть не может.
rule rc_off strict @ anaerobic: ¬regenerates_NAD(system: ?s, pathway: ?p) <-
    uses(system: ?s, pathway: ?p, times: ?u),
    path_net(pathway: ?p, species: CHEBI_15379, value: ?v), ?v < 0

# --- Проверки -------------------------------------------------------------

# Баланс объявленных реакций.
query balanced_all(reaction: RHEA_23444) @ expect yes
query balanced_all(reaction: pyruvate_decarboxylase) @ expect yes
query balanced_all(reaction: alcohol_dehydrogenase) @ expect yes
query balanced_all(reaction: rc_lumped) @ expect yes

# Гликолиз: одна глюкоза уходит, два пирувата и два ATP приходят.
query path_net(pathway: glycolysis, species: CHEBI_4167, value: -1) @ expect yes
query path_net(pathway: glycolysis, species: CHEBI_15361, value: 2) @ expect yes
query path_net(pathway: glycolysis, species: CHEBI_30616, value: 2) @ expect yes

# ЛДГ: пируват восстанавливается, NADH окисляется, NAD+ возвращается.
query path_net(pathway: lactate_fermentation, species: CHEBI_15361, value: -2) @ expect yes
query path_net(pathway: lactate_fermentation, species: CHEBI_16651, value: 2) @ expect yes
query path_net(pathway: lactate_fermentation, species: CHEBI_57945, value: -2) @ expect yes
query path_net(pathway: lactate_fermentation, species: CHEBI_57540, value: 2) @ expect yes
query path_net(pathway: lactate_fermentation, species: CHEBI_30616, value: 0) @ expect yes

# Дрожжи: CO2 отщепляется, ацетальдегид — промежуточное (в итоге ноль),
# этанол накапливается, NADH окисляется.
query path_net(pathway: alcohol_fermentation, species: CHEBI_16526, value: 2) @ expect yes
query path_net(pathway: alcohol_fermentation, species: CHEBI_15343, value: 0) @ expect yes
query path_net(pathway: alcohol_fermentation, species: CHEBI_16236, value: 2) @ expect yes
query path_net(pathway: alcohol_fermentation, species: CHEBI_57945, value: -2) @ expect yes
query path_net(pathway: alcohol_fermentation, species: CHEBI_30616, value: 0) @ expect yes

# Два лактата на глюкозу, NAD+ сходится в ноль, кислород не нужен,
# а ATP остаётся на уровне гликолиза — два.
query sys_net(system: muscle_lactate, species: CHEBI_16651, value: 2) @ anaerobic expect yes
query sys_net(system: muscle_lactate, species: CHEBI_57540, value: 0) @ anaerobic expect yes
query sys_net(system: muscle_lactate, species: CHEBI_15379, value: 0) @ anaerobic expect yes
query sys_net(system: muscle_lactate, species: CHEBI_30616, value: 2) @ anaerobic expect yes

# То же для спиртовой: два этанола, два CO2, лактата нет, ATP те же два.
query sys_net(system: yeast_alcohol, species: CHEBI_16236, value: 2) @ anaerobic expect yes
query sys_net(system: yeast_alcohol, species: CHEBI_16526, value: 2) @ anaerobic expect yes
query sys_net(system: yeast_alcohol, species: CHEBI_16651, value: 0) @ anaerobic expect yes
query sys_net(system: yeast_alcohol, species: CHEBI_15379, value: 0) @ anaerobic expect yes
query sys_net(system: yeast_alcohol, species: CHEBI_30616, value: 2) @ anaerobic expect yes

# Голый гликолиз ATP даёт, но NAD+ не возвращает: NAD+ среда не поставляет.
query sys_net(system: glycolysis_only, species: CHEBI_30616, value: 2) @ expect yes
query lacking(system: glycolysis_only, species: CHEBI_57540) @ expect yes
query works(system: glycolysis_only) @ anaerobic expect no

# Ферментации работают без кислорода; дыхательная цепь без него — нет.
query works(system: muscle_lactate) @ anaerobic expect yes
query works(system: yeast_alcohol) @ anaerobic expect yes
query works(system: respiring) @ anaerobic expect no
query works(system: respiring) @ aerobic expect yes
query sys_net(system: respiring, species: CHEBI_15379, value: -1) @ aerobic expect yes

# При кислороде NADH окисляет дыхательная цепь, без него — ферментация.
query regenerates_NAD(system: muscle_lactate, pathway: lactate_fermentation) @ anaerobic expect yes
query regenerates_NAD(system: yeast_alcohol, pathway: alcohol_fermentation) @ anaerobic expect yes
query regenerates_NAD(system: respiring, pathway: nadh_oxidation) @ anaerobic expect no
query regenerates_NAD(system: respiring, pathway: nadh_oxidation) @ aerobic expect yes

# --- harness: balance of every declared reaction ---
query balanced_all(reaction: alcohol_dehydrogenase) @ expect yes
query balanced_all(reaction: pyruvate_decarboxylase) @ expect yes
query balanced_all(reaction: rc_lumped) @ expect yes
